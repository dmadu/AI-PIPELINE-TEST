# Backend environment variables (copy to backend/.env for local, non-Docker runs).
# Never commit real secrets.

# development | production | testing
FLASK_ENV=development
APP_ENV=development

# SQLAlchemy connection string (use localhost when running outside Docker).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb

# Replace with long random values (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`).
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Browser origin allowed by CORS for /api/* requests.
FRONTEND_ORIGIN=http://localhost:3000
