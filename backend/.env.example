# ---------------------------------------------------------------------------
# Backend environment variables (backend/app/config.py)
# Copy to backend/.env for a local, non-Docker run:  cp .env.example .env
# When running with Docker Compose the ROOT .env file is used instead.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Flask entrypoint used by the `flask` CLI (flask db upgrade, flask shell, ...)
FLASK_APP=wsgi.py

# Active configuration class: development | production | testing
FLASK_ENV=development
CONFIG_NAME=development

# Flask session / signing secret - replace with a long random value
SECRET_KEY=change-me-dev-secret-key

# JWT signing secret used by Flask-JWT-Extended - replace with a random value
JWT_SECRET_KEY=change-me-dev-jwt-secret-key

# SQLAlchemy connection string.
# Inside Docker Compose the database host is the compose service name: db
DATABASE_URL=postgresql://appuser:apppassword@db:5432/appdb

# Allowed browser origin for CORS (the Vite/nginx frontend)
FRONTEND_ORIGIN=http://localhost:3000

# Optional: port gunicorn / flask run binds to inside the container
PORT=5000
