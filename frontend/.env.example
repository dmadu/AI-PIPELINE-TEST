# Frontend environment variables (Vite)
# Copy to .env (git-ignored) and adjust as needed. Never commit real secrets.

# Base URL used by the axios client (frontend/src/api/client.js).
# Relative value keeps requests same-origin so the Vite dev proxy (and the
# nginx container in production) can forward them to the Flask backend.
VITE_API_BASE_URL=/api/v1

# Target used by the Vite dev-server proxy for /api requests.
# Local (non-Docker) development: http://localhost:5000
# Inside Docker Compose:          http://backend:5000
VITE_PROXY_TARGET=http://localhost:5000

# Port the Vite dev server listens on (matches docker-compose frontend mapping).
VITE_DEV_PORT=3000
