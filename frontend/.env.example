# Frontend environment variables (Vite)
# Copy to .env and adjust for your environment. Never commit real secrets.

# Base URL of the backend REST API, including the /api/v1 prefix and no trailing slash.
# Local Vite dev server (backend running on the host):
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Docker Compose: the browser still talks to the published backend port, e.g.
# VITE_API_BASE_URL=http://localhost:5000/api/v1
