# ---------------------------------------------------------------------------
# Root environment file consumed by docker-compose.yml
# Copy it before starting the stack:  cp .env.example .env
# Replace every "change-me" value before any non-local deployment.
# ---------------------------------------------------------------------------

# --- PostgreSQL 16 (db service) -------------------------------------------
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=appdb

# Host port the db container is published on (optional convenience)
POSTGRES_PORT=5432

# --- Backend (Flask API) ---------------------------------------------------
# Flask CLI entrypoint (flask db upgrade / flask db migrate inside the container)
FLASK_APP=wsgi.py

# Active configuration class: development | production | testing
FLASK_ENV=development
CONFIG_NAME=development

# Secrets - replace with long random values
SECRET_KEY=change-me-dev-secret-key
JWT_SECRET_KEY=change-me-dev-jwt-secret-key

# IMPORTANT: inside Docker Compose the database host is the service name `db`,
# not localhost. Keep user/password/database in sync with POSTGRES_* above.
DATABASE_URL=postgresql://appuser:apppassword@db:5432/appdb

# Browser origin allowed by CORS (frontend container / Vite dev server)
FRONTEND_ORIGIN=http://localhost:3000

# Host port the backend container is published on
BACKEND_PORT=5000
