# ---------------------------------------------------------------------------
# Shared Docker Compose environment variables
# Copy this file to .env (`cp .env.example .env`) and adjust the values.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=appuser
POSTGRES_PASSWORD=appsecret
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# Backend (Flask)
FLASK_CONFIG=production
BACKEND_PORT=5000
DATABASE_URL=postgresql+psycopg2://appuser:appsecret@db:5432/appdb
SECRET_KEY=change-me-secret-key
JWT_SECRET_KEY=change-me-jwt-secret-key

# Origin allowed by the backend CORS configuration - must match the URL the
# browser uses to load the SPA (the published frontend port below).
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (Vite/React served by nginx)
FRONTEND_PORT=3000
# Baked into the SPA at build time (Vite inlines VITE_* variables).
VITE_API_BASE_URL=http://localhost:5000/api/v1
