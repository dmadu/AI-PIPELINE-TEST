# =============================================================================
# Example environment configuration - SAFE PLACEHOLDERS ONLY, NO REAL SECRETS.
#
# Copy this file to `.env` at the repository root before running the stack:
#
#   cp .env.example .env
#
# The real `.env` file is git-ignored (see .gitignore) and must never be
# committed. Values below are grouped by concern so the Docker Compose file
# delivered in a later task can map them directly onto the services.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL - consumed by the `db` service (postgres:16) in docker-compose.yml
# -----------------------------------------------------------------------------

# Database super user created on first container start.
POSTGRES_USER=user

# Password for POSTGRES_USER. Replace with a strong value in your local .env.
POSTGRES_PASSWORD=password

# Name of the application database created on first container start.
POSTGRES_DB=dbname

# -----------------------------------------------------------------------------
# Backend (Flask) - consumed by backend/app/config.py and the `backend` service
# -----------------------------------------------------------------------------

# SQLAlchemy connection string. Host `db` is the Compose service name for
# PostgreSQL; the user/password/database must match the POSTGRES_* values above.
# For a backend running directly on the host (no Docker), use `localhost`.
DATABASE_URL=postgresql://user:password@db:5432/dbname

# Secret used to sign JWT access tokens (Flask-JWT-Extended). Change it.
JWT_SECRET_KEY=change-me-jwt-secret-key

# Flask application secret key (session/signing). Change it.
SECRET_KEY=change-me-flask-secret-key

# Browser origin allowed by CORS - the frontend dev/container origin.
FRONTEND_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend (Vite) - build/runtime variable for the React application
# -----------------------------------------------------------------------------

# Base URL of the REST API as seen from the browser (backend published port
# 5000 + the /api/v1 base path).
VITE_API_BASE_URL=http://localhost:5000/api/v1
